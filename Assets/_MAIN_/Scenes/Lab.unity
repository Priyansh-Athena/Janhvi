--- !u!114 &1606913968
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1606913966}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 6d917413b28cd924e9620d87e27f790f, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  runOnStart: 0
  speakerName: Chief Investigator
  steps:
  - text: Before we begin, let me explain something important.
    onStepStart:
      m_PersistentCalls:
        m_Calls: []
    onStepEnd:
      m_PersistentCalls:
        m_Calls: []
    autoDelay: 0
  - text: Forensics is the use of science to investigate crimes.
    onStepStart:
      m_PersistentCalls:
        m_Calls: []
    onStepEnd:
      m_PersistentCalls:
        m_Calls: []
    autoDelay: 0
  - text: 'Investigators analyze evidence such as:

      Fingerprints, Blood samples,
      Fibers, Tool marks, DNA'
    onStepStart:
      m_PersistentCalls:
        m_Calls: []
    onStepEnd:
      m_PersistentCalls:
        m_Calls: []
    autoDelay: 0
  - text: These clues help us reconstruct what happened.
    onStepStart:
      m_PersistentCalls:
        m_Calls: []
    onStepEnd:
      m_PersistentCalls:
        m_Calls: []
    autoDelay: 0
  - text: Even the smallest trace can expose a criminal.
    onStepStart:
      m_PersistentCalls:
        m_Calls: []
    onStepEnd:
      m_PersistentCalls:
        m_Calls:
        - m_Target: {fileID: 1573593914}
          m_TargetAssemblyTypeName: LabManager, Assembly-CSharp
          m_MethodName: WhatIsForensics_1
          m_Mode: 1
          m_Arguments:
            m_ObjectArgument: {fileID: 0}
            m_ObjectArgumentAssemblyTypeName: UnityEngine.Object, UnityEngine
            m_IntArgument: 0
            m_FloatArgument: 0
            m_StringArgument: 
            m_BoolArgument: 0
          m_CallState: 2
    autoDelay: 0
