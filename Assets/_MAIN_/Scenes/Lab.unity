  runOnStart: 0
  speakerName: Assistant
  steps:
  - text: Good work.
    onStepStart:
      m_PersistentCalls:
        m_Calls: []
    onStepEnd:
      m_PersistentCalls:
        m_Calls: []
    autoDelay: 0
  - text: The powder sticks to the oils left by fingerprints.
    onStepStart:
      m_PersistentCalls:
        m_Calls: []
    onStepEnd:
      m_PersistentCalls:
        m_Calls: []
    autoDelay: 0
  - text: This reveals the hidden ridge patterns.
    onStepStart:
      m_PersistentCalls:
        m_Calls: []
    onStepEnd:
      m_PersistentCalls:
        m_Calls: []
    autoDelay: 0
  - text: That fingerprint can now be analyzed in our database.
    onStepStart:
      m_PersistentCalls:
        m_Calls: []
    onStepEnd:
      m_PersistentCalls:
        m_Calls: []
    autoDelay: 0
  - text: Investigators also collect trace evidence.
    onStepStart:
      m_PersistentCalls:
        m_Calls: []
    onStepEnd:
      m_PersistentCalls:
        m_Calls: []
    autoDelay: 0
  - text: Trace evidence includes fibers, hairs, dust, or tiny particles.
    onStepStart:
      m_PersistentCalls:
        m_Calls: []
    onStepEnd:
      m_PersistentCalls:
        m_Calls: []
    autoDelay: 0
  - text: These microscopic clues can link a suspect to a crime scene.
    onStepStart:
      m_PersistentCalls:
        m_Calls: []
    onStepEnd:
      m_PersistentCalls:
        m_Calls:
        - m_Target: {fileID: 1573593914}
          m_TargetAssemblyTypeName: LabManager, Assembly-CSharp
          m_MethodName: ForensicsTraining_8
          m_Mode: 1
          m_Arguments:
