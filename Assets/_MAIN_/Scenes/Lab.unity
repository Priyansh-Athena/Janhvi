  m_GameObject: {fileID: 1607090884}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 6d917413b28cd924e9620d87e27f790f, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  runOnStart: 0
  speakerName: Assistant
  steps:
  - text: First, let's talk about documentation.
    onStepStart:
      m_PersistentCalls:
        m_Calls: []
    onStepEnd:
      m_PersistentCalls:
        m_Calls: []
    autoDelay: 0
  - text: Before touching anything at a crime scene, investigators must photograph
      the entire scene.
    onStepStart:
      m_PersistentCalls:
        m_Calls: []
    onStepEnd:
      m_PersistentCalls:
        m_Calls: []
    autoDelay: 0
  - text: Equip your forensics camera from the tool menu.
    onStepStart:
      m_PersistentCalls:
        m_Calls:
        - m_Target: {fileID: 1573593914}
          m_TargetAssemblyTypeName: LabManager, Assembly-CSharp
          m_MethodName: ForensicsTraining_1
          m_Mode: 1
          m_Arguments:
            m_ObjectArgument: {fileID: 0}
            m_ObjectArgumentAssemblyTypeName: UnityEngine.Object, UnityEngine
            m_IntArgument: 0
            m_FloatArgument: 0
            m_StringArgument: 
            m_BoolArgument: 0
          m_CallState: 2
    onStepEnd:
      m_PersistentCalls:
        m_Calls: []
    autoDelay: 0
  - text: It records the condition of the scene before evidence is disturbed.
    onStepStart:
      m_PersistentCalls:
        m_Calls: []
    onStepEnd:
      m_PersistentCalls:
        m_Calls:
        - m_Target: {fileID: 1573593914}
          m_TargetAssemblyTypeName: LabManager, Assembly-CSharp
          m_MethodName: ForensicsTraining_2
          m_Mode: 1
          m_Arguments:
            m_ObjectArgument: {fileID: 0}
            m_ObjectArgumentAssemblyTypeName: UnityEngine.Object, UnityEngine
            m_IntArgument: 0
            m_FloatArgument: 0
            m_StringArgument: 
            m_BoolArgument: 0
          m_CallState: 2
    autoDelay: 0
