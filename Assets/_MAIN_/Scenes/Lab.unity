  m_Name: 
  m_EditorClassIdentifier: 
  runOnStart: 0
  speakerName: Assistant
  steps:
  - text: The next tool is the Fingerprint Dusting Kit.
    onStepStart:
      m_PersistentCalls:
        m_Calls: []
    onStepEnd:
      m_PersistentCalls:
        m_Calls: []
    autoDelay: 0
  - text: Fingerprints are unique patterns on human fingers.
    onStepStart:
      m_PersistentCalls:
        m_Calls: []
    onStepEnd:
      m_PersistentCalls:
        m_Calls: []
    autoDelay: 0
  - text: No two people have identical fingerprints.
    onStepStart:
      m_PersistentCalls:
        m_Calls: []
    onStepEnd:
      m_PersistentCalls:
        m_Calls: []
    autoDelay: 0
  - text: Criminals often leave fingerprints on objects they touch.
    onStepStart:
      m_PersistentCalls:
        m_Calls: []
    onStepEnd:
      m_PersistentCalls:
        m_Calls:
        - m_Target: {fileID: 1573593914}
          m_TargetAssemblyTypeName: LabManager, Assembly-CSharp
          m_MethodName: ForensicsTraining_6
          m_Mode: 1
          m_Arguments:
            m_ObjectArgument: {fileID: 0}
