  m_Name: 
  m_EditorClassIdentifier: 
  runOnStart: 0
  speakerName: Narrator
  steps:
  - text: Every crime leaves a story behind.
    onStepStart:
      m_PersistentCalls:
        m_Calls:
        - m_Target: {fileID: 32865833}
          m_TargetAssemblyTypeName: CityManager, Assembly-CSharp
          m_MethodName: GameIntroduction_1
          m_Mode: 1
          m_Arguments:
            m_ObjectArgument: {fileID: 0}
            m_ObjectArgumentAssemblyTypeName: UnityEngine.Object, UnityEngine
            m_IntArgument: 0
            m_FloatArgument: 0
            m_StringArgument: 
            m_BoolArgument: 0
          m_CallState: 2
    onStepEnd:
      m_PersistentCalls:
        m_Calls: []
    autoDelay: 0
  - text: "A story hidden in fingerprints\u2026"
    onStepStart:
      m_PersistentCalls:
        m_Calls: []
    onStepEnd:
      m_PersistentCalls:
        m_Calls: []
    autoDelay: 0
  - text: "Fibers\u2026"
    onStepStart:
      m_PersistentCalls:
        m_Calls: []
    onStepEnd:
      m_PersistentCalls:
        m_Calls: []
    autoDelay: 0
  - text: "Tool marks\u2026"
    onStepStart:
      m_PersistentCalls:
        m_Calls: []
    onStepEnd:
      m_PersistentCalls:
        m_Calls: []
    autoDelay: 0
  - text: And traces invisible to the human eye.
    onStepStart:
      m_PersistentCalls:
        m_Calls: []
    onStepEnd:
      m_PersistentCalls:
        m_Calls: []
    autoDelay: 0
  - text: Only trained investigators can uncover the truth.
    onStepStart:
      m_PersistentCalls:
        m_Calls: []
    onStepEnd:
      m_PersistentCalls:
        m_Calls: []
    autoDelay: 1
  - text: Welcome to the world of Forensic Investigation.
    onStepStart:
      m_PersistentCalls:
        m_Calls:
        - m_Target: {fileID: 32865833}
          m_TargetAssemblyTypeName: CityManager, Assembly-CSharp
          m_MethodName: GameIntroduction_2
          m_Mode: 1
          m_Arguments:
            m_ObjectArgument: {fileID: 0}
            m_ObjectArgumentAssemblyTypeName: UnityEngine.Object, UnityEngine
            m_IntArgument: 0
            m_FloatArgument: 0
            m_StringArgument: 
            m_BoolArgument: 0
          m_CallState: 2
    onStepEnd:
